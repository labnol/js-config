  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "exports": {
    "./eslint/appsscript": "./eslint/appsscript.js",
    "./eslint/node": "./eslint/node.js",
